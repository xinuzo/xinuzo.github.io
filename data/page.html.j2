      <div id="content" class="row">
        <!-- Sidebar -->
        <div class="col-side">
          <div id="side">
            <nav class="mobile-nav">
              <span id="navtitle"><code>xinuzo.github.io</code></span>
              <button class="nav-toggle" id="navToggle"
                      aria-label="Toggle navigation"
                      aria-expanded="false">☰</button>
            </nav>
            <div class="nav-links" id="navLinks">
              {%- for nl in nav_links %}
                {%- if "indent" in nl %}
                  <h5>
                    &nbsp; • &nbsp;
                    {% if nl.get("src") == src %}
                      <strong>{{ nl["shortname"] }}</strong>
                    {% elif nl.get("src") %}
                      <a href="/{{ nl["src"] }}.html">{{ nl["shortname"] }}</a>
                    {% elif nl.get("url", "").startswith("http") %}
                      <a href="{{ nl["url"] }}" target="_blank" rel="noopener">{{ nl["shortname"] }}</a>
                    {% else %}
                      <a href="{{ nl["url"] }}">{{ nl["shortname"] }}</a>
                    {% endif %}
                  </h5>
                {%- else %}
                  <h4>
                    {% if nl.get("src") == src %}
                      <strong>{{ nl["shortname"] }}</strong>
                    {% elif nl.get("src") %}
                      <a href="/{{ nl["src"] }}.html">{{ nl["shortname"] }}</a>
                    {% elif nl.get("url", "").startswith("http") %}
                      <a href="{{ nl["url"] }}" target="_blank" rel="noopener">{{ nl["shortname"] }}</a>
                    {% else %}
                      <a href="{{ nl["url"] }}">{{ nl["shortname"] }}</a>
                    {% endif %}
                  </h4>
                {%- endif %}
              {%- endfor %}
